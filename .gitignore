# ---------------------------------------------------------------------------
# .gitignore for EMODPS_Reservoir_Optimization (uv-based Python project)
# ---------------------------------------------------------------------------

# Virtual environment
.venv/

# uv
# (keep uv.lock tracked in git so installs are reproducible across machines -
#  do NOT ignore it unless you have a specific reason to)

# Python cache / bytecode
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/

# Environment / secrets
.env
.env.*

# OS junk
.DS_Store
Thumbs.db

# Editor / IDE
.vscode/
.idea/
*.swp

# Jupyter
.ipynb_checkpoints/

# Project outputs - regenerated / local-only, not tracked in git
Output/
Plot/

# Data/ - only the template/example input files (Data/template/) are tracked
# in git, so collaborators have a reference dataset with the expected schema.
# Real project data, dropped directly in Data/, stays local-only.
Data/*
!Data/template/
!Data/template/**

# Logs
*.log